# ============================================================
# ConcursoAI Platform — Variáveis de Ambiente
# Copie para .env.local e preencha com seus valores reais
# ============================================================

# --- Next.js ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ConcursoAI

# --- NextAuth (autenticação) ---
# Gere com: npx auth secret
AUTH_SECRET=replace-me-with-a-random-secret
AUTH_TRUST_HOST=true

# --- Google OAuth (login com Google) ---
# Crie as credenciais em https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client ID). Redirect URI autorizado:
#   https://<SEU-PROJECT-REF>.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Administração (allowlist de e-mails admin) ---
# OPCIONAL. Lista separada por vírgula de e-mails com acesso de administrador.
# Também pode ser gerenciada via system_settings['admin.emails'] (docs/15).
ADMIN_EMAILS=admin@example.com,outro@example.com

# --- Professores (allowlist de e-mails professor) ---
# OPCIONAL. Lista separada por vírgula de e-mails com acesso de professor
# (upload e transformação de apostilas). Também pode ser gerenciada via
# system_settings['professor.emails'].
PROFESSOR_EMAILS=professor@example.com

# --- Supabase ---
# URL do projeto Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — USO SOMENTE NO SERVIDOR (nunca expor)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# JWT secret do Supabase (para verificar tokens NextAuth)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- DeepSeek API (LLM) ---
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Modelos suportados: deepseek-chat (V4 Flash) e deepseek-reasoner (V4 Pro)
DEEPSEEK_MODEL_FLASH=deepseek-chat
DEEPSEEK_MODEL_PRO=deepseek-reasoner

# --- Kimi / Moonshot (modelos de IA) ---
# OPCIONAL. A chave habilita a descoberta de modelos na área administrativa.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2-turbo-preview

# --- ModelRouter (gateway de modelos de IA) ---
# OPCIONAL. Gateway compatível com a API OpenAI.
# NUNCA coloque a chave real aqui — este arquivo é versionado.
# Defina MODELROUTER_API_KEY no seu .env / .env.local (não versionado).
MODELROUTER_BASE_URL=https://modelrouter.id/v1
MODELROUTER_API_KEY=

# --- Storage backend (Knowledge Engine) ---
# STORAGE_BACKEND=supabase seleciona Supabase Storage.
# STORAGE_BACKEND=r2 seleciona Cloudflare R2.
# STORAGE_BACKEND=local seleciona o filesystem do posto de trabalho (ver
# STORAGE_LOCAL_DIR abaixo). Proibido em produção: LOCAL_BACKEND_FORBIDDEN.
# Em desenvolvimento/teste, supabase pode ser o default.
# Em produção, STORAGE_BACKEND deve ser definido explicitamente.
# R2 sem credenciais NÃO faz fallback automático para Supabase.
STORAGE_BACKEND=supabase

# --- Storage local (desenvolvimento / ingestão offline) ---
# OPCIONAL. Raiz dos objetos quando STORAGE_BACKEND=local.
# Default relativo ao cwd: .storage/documents (a pasta é ignorada pelo git).
# Recusa a raiz do filesystem e a raiz do repositório.
# STORAGE_LOCAL_DIR=

# OPCIONAL. Fila de ingestão pendente (bytes gravados, registro no banco adiado
# até existir banco de teste isolado). Default relativo ao cwd:
# .storage/pending-ingest.json.
# PENDING_INGEST_FILE=

# --- Cloudflare R2 (storage S3-compatível — Knowledge Engine) ---
# Variável oficial do bucket: R2_BUCKET.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=concursoai-documents
# OPCIONAL. Endpoint customizado (default: https://<account>.r2.cloudflarestorage.com)
R2_ENDPOINT=

# --- Embeddings (BAAI/bge-m3 — RAG / busca vetorial) ---
# OPCIONAL. Endpoint do serviço de embeddings self-hosted ou API (docs/10-EMBEDDING-STANDARD).
# Se ausente, o sistema funciona em modo FTS-only (busca textual) e o pipeline de
# conhecimento para no status "chunked" (sem busca vetorial). Se presente, o pipeline
# avança para "indexed" e a busca híbrida usa vetores + FTS.
# Endpoint esperado: POST {url} com body { texts: string[], model } → { embeddings: number[][] }
EMBEDDING_API_URL=https://seu-servico-embeddings.example.com/v1/embed
# OPCIONAL. Chave de API do serviço de embeddings (se exigir autenticação Bearer).
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# --- Transcrição de áudio/vídeo (Whisper — Knowledge Engine) ---
# OPCIONAL. Endpoint do serviço de transcrição (Whisper local ou API).
# Sem config, o pipeline rejeita upload de mídia com status claro
# (transcription_needed) — nunca "funciona" em silêncio (docs/06-KNOWLEDGE-ENGINE).
WHISPER_API_URL=

# --- Mercado Pago (pagamentos / assinaturas) ---
# Acesso em: https://www.mercadopago.com.br/developers
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxx-xxxx-xxxx
MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxx-xxxx-xxxx
# Segredo para validar notificações do webhook.
# NÃO é definido por você: o Mercado Pago GERA este secret ao salvar a
# configuração do webhook (Suas integrações → Webhooks → Configurar notificações
# → Salvar). Copie o secret gerado e cole aqui. NÃO deixe como "change-me"
# (com esse valor a validação é pulada).
MERCADO_PAGO_WEBHOOK_SECRET=change-me
# URLs de retorno do checkout
MERCADO_PAGO_SUCCESS_URL=http://localhost:3000/configuracoes?pagamento=sucesso
MERCADO_PAGO_FAILURE_URL=http://localhost:3000/configuracoes?pagamento=falha

# --- Banco de dados (conexão direta para migrações) ---
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- Seguranca de banco de dados (src/lib/db/env-guard.ts) ---
# Desenvolvimento e producao apontam para o MESMO projeto Supabase enquanto nao
# existir staging. O guard bloqueia toda escrita cujo destino nao possa ser
# provado como banco de teste. Nenhuma credencial real pertence a este arquivo.
#
# Project ref do ambiente de producao (usado para comparar):
PROD_SUPABASE_PROJECT_REF=
# Refs de projetos de teste autorizados a receber escrita, separados por virgula:
SAFE_TEST_DATABASE_REFS=
# Conexao direta do projeto (sem pooler); serve de referencia ao guard:
# DIRECT_URL=postgresql://postgres:SENHA@REF.supabase.co:5432/postgres
# E-mail do Playwright: somente @test.local e @e2e.local permitem cleanup:
E2E_USER_EMAIL=e2e-aluno@test.local


# --- CLI de apostilas (scripts/ingest-apostilas.ts) ---
# Sem --source informado e sem esta variavel, o CLI imprime usage e sai com codigo 2.
# Nenhum caminho de maquina fica embutido no repositorio.
# APOSTILA_SOURCE_DIR=/caminho/para/as/apostilas
# Area de trabalho do lote (manifest, reports, logs). Padrao: .apostilas-work
# APOSTILA_WORK_DIR=.apostilas-work

# --- Acervo local dos cadernos (src/lib/questoes/dados-caderno.ts) ---
# Pasta onde o extrator grava os JSON de cada lote. O nome do arquivo nao entra
# aqui: quem declara qual arquivo pertence a qual caderno e o catalogo
# (src/lib/questoes/cadernos.ts). E caminho de maquina, entao vive no .env.local
# de quem homologa e nunca no codigo-tronco: o file-tracing do Next
# (output: standalone) tenta copiar caminho literal encontrado no modulo e a
# build falha com ENOENT. Sem esta variavel, a tela diz que o acervo local esta
# ausente em vez de exibir conteudo inventado.
# MATERIAIS_DATASET_DIR=C:\caminho\do\drive\portugues\questoes
# Nome legado, ainda aceito com precedencia menor que o acima:
# QUESTOES_AULA14_DIR=C:\caminho\do\drive\cbm-rj\portugues\questoes

# Versao das regras de processamento editorial gravada em documents.metadata.
# processing_version. So mude quando uma linha de texto pode sair diferente do
# lote anterior. O valor precisa casar com ^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$.
# APOSTILA_PROCESSING_VERSION=2026-09-13.1

# --- Transformacao de apostila (src/lib/knowledge/services/apostila-transformer.service.ts) ---
# Modo do pipeline editorial, chamado pelo DocumentPipelineService (upload web,
# CLI e reprocessamento usam o mesmo ponto):
#   sanitize-only  redige PII e normaliza estrutura; nunca toca a rede (PADRAO)
#   structure      o acima + reorganizacao em fases por IA
#   full           o acima + caixas de destaque por IA
# Os modos com IA sao deliberadamente explicitos: cada apostila ingerida vira uma
# chamada externa, e o texto que entra no indice passa a ser o da IA (sem citacao
# de pagina). Se a IA falhar ou reprovar nos portoes de questoes/procedencia, o
# documento cai sozinho em sanitize-only e o upload continua.
# APOSTILA_TRANSFORM_MODE=sanitize-only
# Kill-switch: 1/true/sim devolve ao chunker o texto extraido cru, sem edicao.
# APOSTILA_TRANSFORM_DISABLED=
# Caminho do arquivo de regras editoriais. O padrao e
# src/lib/knowledge/config/apostila-rules.md; em deploy empacotado (standalone)
# esse caminho pode nao existir, entao aponte para uma copia lida em disco. Sem
# arquivo, o pipeline aplica as regras compiladas e o relatorio marca
# regras_fonte=compilado. A leitura e cacheada por mtime: editar vale sem restart.
# APOSTILA_RULES_PATH=/etc/concursoai/apostila-rules.md

# --- Headers de seguranca (src/lib/security/csp.ts) ---
# Padrao: Content-Security-Policy-Report-Only, para nao quebrar a aplicacao por
# suposicao. CSP_ENFORCE=true grava o header de aplicacao real. Em producao a
# aplicacao e o padrao, a menos que CSP_REPORT_ONLY=true diga o contrario.
# CSP_ENFORCE=true
# CSP_REPORT_ONLY=true


# --- Interruptor da rota RAG (src/app/api/ai/rag/route.ts) ---
# A rota POST /api/ai/rag esta DESATIVADA POR PADRAO: sem esta variavel definida
# ela responde 503 e nao toca sessao, banco, quota nem provedor pago. Liberacao e
# opt-in explicito e so aceita true/false (espaco e maiuscula tolerados). Valor
# ausente, vazio ou nao reconhecido mantem a rota fechada - nada de truthiness.
# RAG_API_DISABLED=true
# Para habilitar (somente com consumidora funcional e quota validada):
# RAG_API_DISABLED=false