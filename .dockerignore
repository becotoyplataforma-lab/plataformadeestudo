# Dependências e build local
node_modules
.next
out
tsconfig.tsbuildinfo
next-env.d.ts

# Controle de versão e IDE
.git
.gitignore
.vscode
.idea
.ai

# Segredos — NUNCA entram na imagem
.env
.env.*
!.env.example

# Infra (não vai para a imagem; usada só pelo compose/CI local)
infra

# Documentação e testes (não necessários em runtime)
