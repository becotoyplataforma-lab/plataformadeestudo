# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (nunca commitar segredos!)
.env
.env.production
.env.local
.env.development.local
.env.test.local
.env.production.local
# exceto o template de exemplo (sem segredos reais)
!.env.example

# infra — produção (nunca commitar segredos/backups/certificados)
/infra/.env.production
/infra/certs/
/infra/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# artefatos de auditoria (não versionar)
/visual-audit/
/test-results/

# estado de teste manual (não versionar)
/.mp-test-user.json
/.tmp-preapproval.json

# materiais de estudo do usuário (não versionar)
/materiais/

# supabase
supabase/.temp

# drizzle — migrations versionadas (fonte de verdade do schema p/ banco novo)
# (removido do gitignore em 2026-08-22 — Fase 1: consolidar schema)
# drizzle/

# storage local de arquivos de usuários (NUNCA commitar — ver .ai/08-SECURITY-STANDARDS)
/.storage/

# Arquivos brutos sincronizados do Drive (nao commitar no git)
/public/apostilas/
/public/apostilas-adaptadas/matematica-aula-*-adaptada.pdf
/.apostilas-work/

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

print/

# Log local do dev server
/dev.log
.apostilas-work/

# binarios de material didatico: nunca entram no repositorio
/*.pdf
/*.docx
/*.epub

# logs de execucao de qualquer ferramenta
*.log

# saida da medicao calibrada de catalogo (docs/27): dump opcional, nao versionar
/probe.json
/*.probe.json
/database/knowledge/tmp/

# Comentário de material de terceiro: referência local de revisão. Nunca
# publicado, nunca importado, nunca versionado (agents/pdf_question_extractor).
comentarios_*_LOCAL.json
.aula14_linhas_limpas.json

# Python do extrator: bytecode e ambiente local nunca entram no repositorio.
__pycache__/
*.pyc
.venv/

# Sucata de sessao na RAIZ: dumps de saida de ferramenta (tsc/eslint/vitest/
# playwright), sondas avulsas de HTTP e banco, e scripts descartaveis. As
# regras sao ancoradas em / de proposito: o extrator tem _*.py e _*.mjs
# legitimos em subpastas (agents/pdf_question_extractor/tests/_gerar_golden.mjs),
# e uma regra sem ancora os ignoraria silenciosamente no futuro.
/_*.txt
/_*.py
/_*.mjs
/_*.ts
/_*.log

# Relatorios e checklists de rodada: retrato pontual de uma maquina, com SHA e
# data no cabecalho. A documentacao definitiva e versionada vive em docs/.
/RELATORIO-*.md
/CHECKLIST-LANCAMENTO-MVP.md

# Worktrees de validacao criados dentro do proprio repositorio (.wt-b1 ate .wt-b4).
# Sem esta regra, um "git add ." commita uma copia inteira da arvore (931 arquivos)
# como pasta comum — foi o risco que os blocos B1-B4 correram a cada validacao.
/.wt-*/


# Storage local (STORAGE_BACKEND=local) e fila de ingestao pendente:
# bytes de apostila e caminhos do posto de trabalho. Nunca versionar.
/.storage/

public/deploy-*.json
public/deploy-*.txt
