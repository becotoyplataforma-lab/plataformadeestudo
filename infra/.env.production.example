# ============================================================
# ConcursoAI Platform — Variáveis de PRODUÇÃO (Sprint 18.2B)
# Copie para .env.production na RAIZ do projeto (não em infra/).
# NUNCA commitar o .env.production preenchido (contém segredos).
# ============================================================

# --- App ---
APP_NAME=ConcursoAI
APP_ENV=production
APP_URL=https://app.becotoy.com
LOG_LEVEL=info
TZ=America/Sao_Paulo

# --- Domínio (públicas, embutidas no bundle em build-time) ---
NEXT_PUBLIC_APP_URL=https://app.becotoy.com
NEXT_PUBLIC_APP_NAME=ConcursoAI

# --- NextAuth (gerar com: npx auth secret) ---
AUTH_SECRET=replace-me-with-a-strong-secret
AUTH_TRUST_HOST=true

# --- Administração (allowlist de e-mails admin) ---
# OBRIGATÓRIO para acesso ao painel admin. Lista separada por vírgula.
ADMIN_EMAILS=admin@example.com

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- DeepSeek (LLM) ---
# OBRIGATÓRIO para geração de questões, correção de redação e consolidação.
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FLASH=deepseek-chat
DEEPSEEK_MODEL_PRO=deepseek-reasoner

# --- Embeddings (BAAI/bge-m3 — RAG / busca vetorial) ---
# OBRIGATÓRIO em produção para ativar a busca vetorial (docs/10-EMBEDDING-STANDARD).
# Sem config, o sistema roda em modo FTS-only e o pipeline para em "chunked".
EMBEDDING_API_URL=https://seu-servico-embeddings.example.com/v1/embed
# OPCIONAL. Chave de API do serviço de embeddings (se exigir autenticação Bearer).
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# --- Transcrição de áudio/vídeo (Whisper — Knowledge Engine) ---
# OPCIONAL. Sem config, o pipeline rejeita upload de mídia com status claro.
WHISPER_API_URL=

# --- Cloudflare R2 (storage S3-compatível — Knowledge Engine) ---
# OPCIONAL. Sem config, o storage cai no fallback Supabase Storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=concursoai-documents
# OPCIONAL. Endpoint customizado (default: https://<account>.r2.cloudflarestorage.com)
R2_ENDPOINT=

# --- Mercado Pago (pagamentos / assinaturas) ---
# OBRIGATÓRIO para cobrança de assinaturas (checkout + auto-renewal via Preapproval).
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxx-xxxx
MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxx-xxxx
# OBRIGATÓRIO. Segredo para validar notificações do webhook (definido por você).
MERCADO_PAGO_WEBHOOK_SECRET=change-me
MERCADO_PAGO_SUCCESS_URL=https://app.becotoy.com/configuracoes?pagamento=sucesso
MERCADO_PAGO_FAILURE_URL=https://app.becotoy.com/configuracoes?pagamento=falha

# --- Banco de dados (Supabase PostgreSQL) ---
# Para produção, prefira a string do Pooler/Transaction do Supabase:
# postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
